#!/usr/bin/env python3

# Example test run: ./SIM <(/SIMGRADING/Random 6) <REPLICATIONS OF N> ../tmp/CriticalPath/multiple_critical.net
# Where <(/SIMGRADING/Random 6) is a pipe from the pRNG script into our program using std in

import sys

from Elevator import ElevatorNES

def main(args):
    FLOORS = int(args[1])
    ELEVATORS = int(args[2])
    trace = args[3]
    DAYS = int(args[4])
    
    # Create Elevator NES object
    _nes = ElevatorNES(FLOORS, ELEVATORS, trace, DAYS)
    
    STOPS, MAXQ, AVGDELAY, STDDELAY = _nes.NES_Main()
    
    print(f"OUTPUT stops {STOPS}")
    print(f"OUTPUT maxQ {MAXQ}")
    print(f"OUTPUT avgDelay {AVGDELAY}")
    print(f"OUTPUT stdDelay {STDDELAY}")
    


if __name__ == "__main__":
    main(sys.argv)